      "grammar": [{"rule": "Тон над гласной", "explain": "wǒ, nǐ, dà", "examples": [{"hanzi": "我是中国人。", "pinyin": "Wǒ shì Zhōngguó rén.", "ru": "Я китаец."}]}],
