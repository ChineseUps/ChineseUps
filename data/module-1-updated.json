        {"type": "match", "q": "Местоимения", "pairs": [{"left": "我", "right": "я"}, {"left": "你", "right": "ты"}], "explain": "Базовые слова."},
        {"type": "choice", "q": "Где тон в wǒ？", "options": ["Над w", "Над o", "В конце"], "answer": 1, "explain": "Над гласной."},
