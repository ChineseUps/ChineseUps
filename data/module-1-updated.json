      "dialogue": {"title": "Покупка", "lines": [
        {"speaker": "A", "hanzi": "买什么？", "pinyin": "Mǎi shénme?", "ru": "Что покупаешь?"},
        {"speaker": "B", "hanzi": "苹果。", "pinyin": "Píngguǒ.", "ru": "Яблоки."}
